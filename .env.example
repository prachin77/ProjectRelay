# ---------------------------------------------------------------------------
# The Relay — environment template
#
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored. Never commit a real key (assignment rule).
#
#   Copy-Item .env.example .env
#
# Every variable is optional except GROQ_API_KEY when you actually call Groq.
# Defaults are chosen so the system runs offline (stand-in provider) with no
# key at all, which is what the test suite uses.
# ---------------------------------------------------------------------------

# --- Provider ---------------------------------------------------------------
# "groq"    = real hosted model (consumes your free-tier quota)
# "standin" = deterministic local simulator (consumes nothing)
RELAY_PROVIDER=standin

# Your own free Groq account key. Get it from https://console.groq.com/keys
# Leave blank to run entirely on the stand-in.
GROQ_API_KEY=

# Model choice. Verified free-tier limits on 2026-11-10:
#   openai/gpt-oss-120b : RPM 30, RPD 1000, TPM 8000, TPD 200000
#   openai/gpt-oss-20b  : RPM 30, RPD 1000, TPM 8000, TPD 200000
RELAY_GROQ_MODEL=openai/gpt-oss-120b
RELAY_GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Redis cache ------------------------------------------------------------
RELAY_REDIS_URL=redis://127.0.0.1:6379/0
# Feature flag: turning this off proves the pipeline still answers correctly
# without Redis (a required demonstration for the live discussion).
RELAY_CACHE_ENABLED=true
# Semantic cache is OFF by default. It is only enabled once the
# false-positive test suite and threshold tuning justify it.
RELAY_SEMANTIC_CACHE_ENABLED=false

# --- Quota (must match the provider's real limits) --------------------------
# These are the *documented* free-tier numbers. The probe records the numbers
# our account actually reports in response headers, which is authoritative.
RELAY_QUOTA_RPM=30
RELAY_QUOTA_TPM=8000
RELAY_QUOTA_RPD=1000
RELAY_QUOTA_TPD=200000
RELAY_MAX_CONCURRENCY=4
RELAY_MAX_QUEUE_DEPTH=32
RELAY_REQUEST_DEADLINE_MS=20000

# --- Paths ------------------------------------------------------------------
RELAY_DOCUMENTS_DIR=documents
RELAY_INDEX_DIR=indexes
RELAY_LOGS_DIR=logs
RELAY_RESULTS_DIR=results
RELAY_CONFIG_DIR=config
