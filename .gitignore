# ---------------------------------------------------------------------------
# Secrets. NEVER commit .env. The assignment explicitly forbids shipping the key.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Virtual environment
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Generated / heavy artefacts.
# These are reproducible from documents/ + config/, so they stay out of git.
# The raw experiment results in results/ ARE kept -- they are graded evidence.
# ---------------------------------------------------------------------------
indexes/
logs/*.jsonl
!logs/.gitkeep

# Local scratch
scratch/
*.sqlite
*.db
dump.rdb
appendonly.aof

dist/
